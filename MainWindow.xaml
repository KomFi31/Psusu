<Window x:Class="FitnessCentar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fitness Centar"
        Height="650"
        Width="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header aplikacije -->
        <Border Grid.Row="0"
                Background="#1F2937"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Fitness Centar"
                           Foreground="White"
                           FontSize="30"
                           FontWeight="Bold"/>

                <TextBlock Text="Evidencija trenera i klijenata"
                           Foreground="#D1D5DB"
                           FontSize="15"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Glavni sadržaj -->
        <TabControl Grid.Row="1"
                    Background="White"
                    BorderThickness="0">

            <!-- TAB: TRENERI -->
            <TabItem Header="Treneri">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Dugmad za CRUD operacije nad trenerima -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,10">

                        <Button Content="Dodaj trenera"
                                Width="130"
                                Height="36"
                                Margin="0,0,10,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="AddTrainerButton_Click"/>

                        <Button Content="Detalji"
                                Width="100"
                                Height="36"
                                Margin="0,0,10,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="TrainerDetailsButton_Click"/>

                        <Button Content="Izmeni"
                                Width="100"
                                Height="36"
                                Margin="0,0,10,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="EditTrainerButton_Click"/>

                        <Button Content="Obriši"
                                Width="100"
                                Height="36"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="DeleteTrainerButton_Click"/>
                    </StackPanel>

                    <!-- Tabelarni prikaz trenera -->
                    <DataGrid x:Name="TrainersDataGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              RowHeight="35"
                              AlternatingRowBackground="#F9FAFB"
                              GridLinesVisibility="Horizontal">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding TrainerId}"
                                                Width="60"/>

                            <DataGridTextColumn Header="Ime"
                                                Binding="{Binding FirstName}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Prezime"
                                                Binding="{Binding LastName}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Specijalizacija"
                                                Binding="{Binding Specialization}"
                                                Width="2*"/>

                            <DataGridTextColumn Header="Godine iskustva"
                                                Binding="{Binding YearsOfExperience}"
                                                Width="140"/>

                            <DataGridTextColumn Header="Broj klijenata"
                                                Binding="{Binding Clients.Count}"
                                                Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB: KLIJENTI -->
            <TabItem Header="Klijenti">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Dugmad za CRUD operacije nad klijentima -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,10">

                        <Button Content="Dodaj klijenta"
                                Width="130"
                                Height="36"
                                Margin="0,0,10,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="AddClientButton_Click"/>

                        <Button Content="Detalji"
                                Width="100"
                                Height="36"
                                Margin="0,0,10,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ClientDetailsButton_Click"/>

                        <Button Content="Izmeni"
                                Width="100"
                                Height="36"
                                Margin="0,0,10,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="EditClientButton_Click"/>

                        <Button Content="Obriši"
                                Width="100"
                                Height="36"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="DeleteClientButton_Click"/>
                    </StackPanel>

                    <!-- Tabelarni prikaz klijenata -->
                    <DataGrid x:Name="ClientsDataGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              RowHeight="35"
                              AlternatingRowBackground="#F9FAFB"
                              GridLinesVisibility="Horizontal">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding ClientId}"
                                                Width="60"/>

                            <DataGridTextColumn Header="Ime"
                                                Binding="{Binding FirstName}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Prezime"
                                                Binding="{Binding LastName}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Godine"
                                                Binding="{Binding Age}"
                                                Width="80"/>

                            <DataGridTextColumn Header="Težina"
                                                Binding="{Binding Weight}"
                                                Width="90"/>

                            <DataGridTextColumn Header="Cilj"
                                                Binding="{Binding Goal}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Telefon"
                                                Binding="{Binding PhoneNumber}"
                                                Width="130"/>

                            <DataGridTextColumn Header="Datum članstva"
                                                Binding="{Binding MembershipStartDate, StringFormat=dd.MM.yyyy}"
                                                Width="130"/>

                            <DataGridTextColumn Header="Trener"
                                                Binding="{Binding Trainer}"
                                                Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>