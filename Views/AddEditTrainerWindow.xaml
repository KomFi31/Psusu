<Window x:Class="FitnessCentar.Views.AddEditTrainerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trener"
        Height="430"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F4F6">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Naslov prozora se menja u zavisnosti od toga da li se dodaje ili menja trener. -->
        <TextBlock x:Name="TitleTextBlock"
                   Grid.Row="0"
                   Text="Dodavanje trenera"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#111827"
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Ime:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,12"/>

                <TextBox x:Name="FirstNameTextBox"
                         Grid.Row="0"
                         Grid.Column="1"
                         Height="32"
                         Margin="0,0,0,12"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Prezime:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,12"/>

                <TextBox x:Name="LastNameTextBox"
                         Grid.Row="1"
                         Grid.Column="1"
                         Height="32"
                         Margin="0,0,0,12"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Specijalizacija:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,12"/>

                <TextBox x:Name="SpecializationTextBox"
                         Grid.Row="2"
                         Grid.Column="1"
                         Height="32"
                         Margin="0,0,0,12"/>

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="Godine iskustva:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <TextBox x:Name="YearsOfExperienceTextBox"
                         Grid.Row="3"
                         Grid.Column="1"
                         Height="32"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="Sačuvaj"
                    Width="110"
                    Height="36"
                    Margin="0,0,10,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="SaveButton_Click"/>

            <Button Content="Odustani"
                    Width="110"
                    Height="36"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>