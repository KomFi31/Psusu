<Window x:Class="FitnessCentar.Views.ClientDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalji klijenta"
        Height="560"
        Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F4F6">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Detalji klijenta"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#111827"
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="ID:"
                           FontWeight="SemiBold"
                           Margin="0,0,10,12"/>

                <TextBlock x:Name="ClientIdTextBlock"
                           Grid.Row="0" Grid.Column="1"
                           Margin="0,0,0,12"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Ime:"
                           FontWeight="SemiBold"
                           Margin="0,0,10,12"/>

                <TextBlock x:Name="FirstNameTextBlock"
                           Grid.Row="1" Grid.Column="1"
                           Margin="0,0,0,12"/>

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Prezime:"
                           FontWeight="SemiBold"
                           Margin="0,0,10,12"/>

                <TextBlock x:Name="LastNameTextBlock"
                           Grid.Row="2" Grid.Column="1"
                           Margin="0,0,0,12"/>

                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="Godine:"
                           FontWeight="SemiBold"
                           Margin="0,0,10,12"/>

                <TextBlock x:Name="AgeTextBlock"
                           Grid.Row="3" Grid.Column="1"
                           Margin="0,0,0,12"/>

                <TextBlock Grid.Row="4" Grid.Column="0"
                           Text="Težina:"
                           FontWeight="SemiBold"
                           Margin="0,0,10,12"/>

                <TextBlock x:Name="WeightTextBlock"
                           Grid.Row="4" Grid.Column="1"
                           Margin="0,0,0,12"/>

                <TextBlock Grid.Row="5" Grid.Column="0"
                           Text="Cilj:"
                           FontWeight="SemiBold"
                           Margin="0,0,10,12"/>

                <TextBlock x:Name="GoalTextBlock"
                           Grid.Row="5" Grid.Column="1"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <TextBlock Grid.Row="6" Grid.Column="0"
                           Text="Telefon:"
                           FontWeight="SemiBold"
                           Margin="0,0,10,12"/>

                <TextBlock x:Name="PhoneNumberTextBlock"
                           Grid.Row="6" Grid.Column="1"
                           Margin="0,0,0,12"/>

                <TextBlock Grid.Row="7" Grid.Column="0"
                           Text="Datum članstva:"
                           FontWeight="SemiBold"
                           Margin="0,0,10,12"/>

                <TextBlock x:Name="MembershipStartDateTextBlock"
                           Grid.Row="7" Grid.Column="1"
                           Margin="0,0,0,12"/>

                <TextBlock Grid.Row="8" Grid.Column="0"
                           Text="Trener:"
                           FontWeight="SemiBold"
                           Margin="0,0,10,0"/>

                <TextBlock x:Name="TrainerTextBlock"
                           Grid.Row="8" Grid.Column="1"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Button Grid.Row="2"
                Content="Zatvori"
                Width="110"
                Height="36"
                HorizontalAlignment="Right"
                Margin="0,20,0,0"
                Style="{StaticResource SecondaryButtonStyle}"
                Click="CloseButton_Click"/>
    </Grid>
</Window>